# URL SSH del repo GitHub PRE-CREADO donde se pusheará la app generada.
# Si está vacío, el finalizador solo hace commit local.
# Ejemplo: git@github.com:damianra/mi-app-generada.git
GITHUB_REPO_URL=

# Identidad git para los commits de las apps generadas
GIT_USER_NAME="Damian Ramirez"
GIT_USER_EMAIL="damianramirezalejandro@gmail.com"

# Modelo de Devin (default: swe-2-high — SWE-2 High gratuito)
DEVIN_MODEL=swe-2-high

# Timeout por llamada a Devin CLI en milisegundos (default: 15 min)
DEVIN_TIMEOUT_MS=900000

# Reintentos
MAX_STEP_RETRIES=3
MAX_PLAN_RETRIES=2
