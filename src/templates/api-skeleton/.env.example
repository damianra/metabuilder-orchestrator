# Variables de entorno de la app — copiar a `.env` (gitignored) y
# completar. Todo lo declarado acá es lo que el código puede leer via
# process.env.NOMBRE — los secretos nunca van hardcodeados ni
# commiteados.

# Puerto de la API (default 4000)
# PORT=4000

# API keys de servicios externos (declarar las que la app necesite):
# MI_API_KEY=
# STRIPE_SECRET_KEY=
