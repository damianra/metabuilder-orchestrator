# Fullstack: build de Vite → dist/ servido por el mismo Express que la API
# (api-skeleton sirve ../dist cuando existe). Un solo contenedor.
FROM node:22 AS deps
WORKDIR /app
COPY package*.json ./
RUN npm ci

FROM node:22 AS proddeps
WORKDIR /app
COPY package*.json ./
RUN npm ci --omit=dev

FROM deps AS build
COPY . .
RUN npm run build

FROM node:22-slim
ENV NODE_ENV=production
WORKDIR /app
COPY --from=proddeps /app/node_modules ./node_modules
COPY package*.json ./
COPY --from=build /app/dist ./dist
COPY server ./server

EXPOSE 4000
CMD ["node", "server/index.js"]
