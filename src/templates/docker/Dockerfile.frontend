# Frontend-only: build del stack → @OUT_DIR@/ servido por nginx.
FROM docker.io/library/node:22 AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM docker.io/library/nginx:alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/@OUT_DIR@ /usr/share/nginx/html
EXPOSE 80
