# Backend-only Python (FastAPI + SQLAlchemy): runtime slim con deps de
# requirements.txt — sin stage de build (interpretado). Convención
# preservada: API en :4000, mismo puerto que los skeletons Express.
FROM docker.io/library/python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt
@ALEMBIC@
COPY app ./app
EXPOSE 4000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "4000"]
