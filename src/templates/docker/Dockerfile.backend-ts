# Backend-only TypeScript (NestJS + TypeORM): build tsc en stage deps,
# runtime slim con prod deps + dist-server/. El código backend vive en
# server/ (en fullstack comparte root con el front: dist/ = vite build,
# dist-server/ = tsc).
FROM docker.io/library/node:22 AS deps
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY tsconfig.json nest-cli.json ./
COPY server ./server
RUN npm run build && npm prune --omit=dev

FROM docker.io/library/node:22-slim
ENV NODE_ENV=production
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY package*.json ./
COPY --from=deps /app/dist-server ./dist-server

EXPOSE 4000
CMD ["node", "dist-server/main.js"]
