# Backend-only TypeScript (NestJS + TypeORM): build tsc en stage deps,
# runtime slim con prod deps + dist/. Sin vite build — el stack es
# backend-only por ahora (fullstack nest queda para cuando haya front).
FROM docker.io/library/node:22 AS deps
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY tsconfig.json nest-cli.json ./
COPY src ./src
RUN npm run build && npm prune --omit=dev

FROM docker.io/library/node:22-slim
ENV NODE_ENV=production
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY package*.json ./
COPY --from=deps /app/dist ./dist

EXPOSE 4000
CMD ["node", "dist/main.js"]
