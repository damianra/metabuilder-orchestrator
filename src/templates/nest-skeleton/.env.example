# Conexión a la base de datos — el usuario la configura en .env
# (gitignored). DB_TYPE: postgres | mysql (mongodb requiere @ObjectIdColumn en las entities)
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=app
DB_USER=postgres
DB_PASSWORD=
# Solo si DB_TYPE=mongodb:
MONGO_URI=mongodb://127.0.0.1:27017
